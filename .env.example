# Copy this file to .env.local and fill in your values

# Upstash Redis (required for production / Vercel)
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# JWT signing secret — REQUIRED in production, at least 32 characters.
# The app refuses to log anyone in without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin phone number, with country code (509 for Haiti, 1 for USA)
ADMIN_PHONE=50900000000

